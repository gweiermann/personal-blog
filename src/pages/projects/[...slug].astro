---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | ${site.name}`} description={project.data.description}>
  <div class="max-w-3xl mx-auto px-6 py-16">
    <!-- Back Link -->
    <a
      href="/projects"
      class="inline-flex items-center gap-2 text-sm text-black/60 hover:text-black mb-12"
    >
      ← Back to Projects
    </a>

    <!-- Header -->
    <header class="mb-12 pb-12 border-b border-black/10">
      <p class="text-xs uppercase tracking-wider text-black/40 mb-4">
        {project.data.year}
      </p>
      <h1 class="text-5xl font-serif leading-tight mb-6">
        {project.data.title}
      </h1>
      <p class="text-lg text-black/80 leading-relaxed mb-6">
        {project.data.description}
      </p>
      <div class="flex flex-wrap gap-2 mb-6">
        {project.data.tags.map((tag) => (
          <span
            class="px-3 py-1 text-xs uppercase tracking-wider border border-black/20 text-black/60"
          >
            {tag}
          </span>
        ))}
      </div>
      {project.data.link && project.data.link !== '#' && (
        <a
          href={project.data.link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium text-black/80 hover:text-black underline"
        >
          View project →
        </a>
      )}
    </header>

    <!-- Content -->
    <article class="prose-custom [&_h2]:text-2xl [&_h2]:font-serif [&_h2]:mt-12 [&_h2]:mb-6 [&_p]:text-lg [&_p]:leading-relaxed [&_p]:text-black/80 [&_p]:mb-6 [&_pre]:mb-6 [&_a]:text-blue-600 [&_a]:underline [&_a:hover]:text-blue-700 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-2 [&_a:focus-visible]:outline-blue-600">
      <Content />
    </article>

    <!-- Footer -->
    <div class="mt-16 pt-12 border-t border-black/10">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-sm uppercase tracking-wider hover:underline"
      >
        View All Projects →
      </a>
    </div>
  </div>
</BaseLayout>
