---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { site } from '../config/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const recentPosts = posts.slice(0, 3);

const projects = await getCollection('projects');
const projectsById = Object.fromEntries(projects.map((p) => [p.id, p]));
const postsById = Object.fromEntries(posts.map((p) => [p.id, p]));

const featuredItems = (site.home.featuredWork ?? [])
  .map((item) => {
    if (item.type === 'project') {
      const project = projectsById[item.slug];
      return project ? { type: 'project' as const, entry: project } : null;
    }
    const post = postsById[item.slug];
    return post ? { type: 'blog' as const, entry: post } : null;
  })
  .filter(Boolean);
---

<BaseLayout title={site.name} description={site.tagline}>
  <div class="max-w-6xl mx-auto px-6">
    <!-- Hero Section -->
    <section class="py-24 border-b border-black/10">
      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-wider text-black/50 mb-6">
          {site.tagline}
        </p>
        <h2 class="text-5xl font-serif leading-tight mb-8">
          {site.home.headline}
        </h2>
        <p class="text-lg leading-relaxed text-black/80 mb-8">
          {site.home.intro}
        </p>
        <div class="flex gap-4">
          <a
            href="/projects"
            class="px-6 py-3 bg-black text-[#ffffff] font-medium tracking-tight hover:bg-black/80 transition-colors"
          >
            View Projects
          </a>
          <a
            href="/blog"
            class="px-6 py-3 border border-black font-medium tracking-tight hover:bg-black hover:text-[#ffffff] transition-colors"
          >
            Read Blog
          </a>
        </div>
      </div>
    </section>

    <!-- Featured Work -->
    <section class="py-24">
      <div class="mb-12">
        <h3 class="text-sm uppercase tracking-wider text-black/50 mb-2 font-medium">
          Featured Work
        </h3>
        <div class="h-px bg-black/10"></div>
      </div>

      <div class="grid grid-cols-2 gap-12">
        {featuredItems.map((item, i) => {
          if (!item) return null;
          const href = item.type === 'project' ? `/projects/${item.entry.id}` : `/blog/${item.entry.id}`;
          const title = item.entry.data.title;
          const description = item.entry.data.description;
          const gradientClass = i % 2 === 0
            ? 'bg-gradient-to-br from-black/10 to-black/5'
            : 'bg-gradient-to-br from-black/5 to-black/10';
          return (
            <a href={href} class="group">
              <div class="aspect-[4/3] bg-black/5 mb-4 overflow-hidden">
                {item.type === 'blog' && item.entry.data.thumbnail ? (
                  <Image
                    src={item.entry.data.thumbnail}
                    alt=""
                    class={`w-full h-full object-cover group-hover:scale-105 transition-transform duration-500`}
                    widths={[400, 800]}
                    sizes="(min-width: 768px) 50vw, 100vw"
                  />
                ) : (
                  <div class={`w-full h-full ${gradientClass} group-hover:scale-105 transition-transform duration-500`} />
                )}
              </div>
              <h4 class="text-xl font-serif mb-2 group-hover:underline font-bold">
                {title}
              </h4>
              <p class="text-black/60 leading-relaxed">
                {description}
              </p>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Recent Posts -->
    <section class="py-24 border-t border-black/10">
      <div class="mb-12">
        <h3 class="text-sm uppercase tracking-wider text-black/50 mb-2 font-medium">
          Recent Writing
        </h3>
        <div class="h-px bg-black/10"></div>
      </div>

      <div class="space-y-8">
        {recentPosts.map((post, i) => (
          <>
            <a href={`/blog/${post.id}`} class="block group">
              <div class="flex gap-8 items-start">
                {post.data.thumbnail && (
                  <div class="w-28 flex-shrink-0 aspect-[4/3] overflow-hidden bg-black/5 rounded">
                    <Image
                      src={post.data.thumbnail}
                      alt=""
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      widths={[112, 224]}
                      sizes="112px"
                    />
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <p class="text-xs uppercase tracking-wider text-black/40 mb-2">
                    {post.data.publishDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </p>
                  <h4 class="text-2xl font-serif mb-3 group-hover:underline">
                    {post.data.title}
                  </h4>
                  <p class="text-black/60 leading-relaxed">
                    {post.data.description}
                  </p>
                </div>
                <div class="text-xs uppercase tracking-wider text-black/40 flex-shrink-0">
                  {post.data.readTimeMinutes ? `${post.data.readTimeMinutes} min read` : '—'}
                </div>
              </div>
            </a>
            {i < recentPosts.length - 1 && <div class="h-px bg-black/10"></div>}
          </>
        ))}
      </div>

      <div class="mt-12">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm uppercase tracking-wider hover:underline"
        >
          View All Posts →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
