---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../config/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const recentPosts = posts.slice(0, 3);
---

<BaseLayout title={site.name} description={site.tagline}>
  <div class="max-w-6xl mx-auto px-6">
    <!-- Hero Section -->
    <section class="py-24 border-b border-black/10">
      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-wider text-black/50 mb-6">
          {site.tagline}
        </p>
        <h2 class="text-5xl font-serif leading-tight mb-8">
          {site.home.headline}
        </h2>
        <p class="text-lg leading-relaxed text-black/70 mb-8">
          {site.home.intro}
        </p>
        <div class="flex gap-4">
          <a
            href="/projects"
            class="px-6 py-3 bg-black text-white hover:bg-black/80 transition-colors"
          >
            View Projects
          </a>
          <a
            href="/blog"
            class="px-6 py-3 border border-black hover:bg-black hover:text-white transition-colors"
          >
            Read Blog
          </a>
        </div>
      </div>
    </section>

    <!-- Featured Work -->
    <section class="py-24">
      <div class="mb-12">
        <h3 class="text-sm uppercase tracking-wider text-black/50 mb-2">
          Featured Work
        </h3>
        <div class="h-px bg-black/10"></div>
      </div>

      <div class="grid grid-cols-2 gap-12">
        <a href="/projects" class="group">
          <div class="aspect-[4/3] bg-black/5 mb-4 overflow-hidden">
            <div class="w-full h-full bg-gradient-to-br from-black/10 to-black/5 group-hover:scale-105 transition-transform duration-500"></div>
          </div>
          <h4 class="text-xl font-serif mb-2 group-hover:underline">
            Generative Art Engine
          </h4>
          <p class="text-black/60 leading-relaxed">
            An algorithmic art system that creates unique visual compositions
            using noise functions and cellular automata.
          </p>
        </a>

        <a href="/projects" class="group">
          <div class="aspect-[4/3] bg-black/5 mb-4 overflow-hidden">
            <div class="w-full h-full bg-gradient-to-br from-black/5 to-black/10 group-hover:scale-105 transition-transform duration-500"></div>
          </div>
          <h4 class="text-xl font-serif mb-2 group-hover:underline">
            Typography Experiments
          </h4>
          <p class="text-black/60 leading-relaxed">
            A collection of interactive typographic compositions exploring
            kinetic text and responsive letterforms.
          </p>
        </a>
      </div>
    </section>

    <!-- Recent Posts -->
    <section class="py-24 border-t border-black/10">
      <div class="mb-12">
        <h3 class="text-sm uppercase tracking-wider text-black/50 mb-2">
          Recent Writing
        </h3>
        <div class="h-px bg-black/10"></div>
      </div>

      <div class="space-y-8">
        {recentPosts.map((post, i) => (
          <>
            <a href={`/blog/${post.id}`} class="block group">
              <div class="flex gap-8 items-start">
                <div class="flex-1">
                  <p class="text-xs uppercase tracking-wider text-black/40 mb-2">
                    {post.data.publishDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </p>
                  <h4 class="text-2xl font-serif mb-3 group-hover:underline">
                    {post.data.title}
                  </h4>
                  <p class="text-black/60 leading-relaxed">
                    {post.data.description}
                  </p>
                </div>
                <div class="text-xs uppercase tracking-wider text-black/40">
                  {post.data.readTimeMinutes ? `${post.data.readTimeMinutes} min read` : '—'}
                </div>
              </div>
            </a>
            {i < recentPosts.length - 1 && <div class="h-px bg-black/10"></div>}
          </>
        ))}
      </div>

      <div class="mt-12">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm uppercase tracking-wider hover:underline"
        >
          View All Posts →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
