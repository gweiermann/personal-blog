---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { site } from '../../config/site';

const blogPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const featured = blogPosts[0];
const rest = blogPosts.slice(1);
---

<BaseLayout title={`Blog | ${site.name}`} description={site.blog.metaDescription}>
  <div class="max-w-6xl mx-auto px-6 py-16">
    <!-- Header -->
    <div class="mb-16 pb-8 border-b border-black/10">
      <h1 class="text-5xl font-serif mb-4">Blog</h1>
      <p class="text-lg text-black/60 max-w-2xl">
        {site.blog.pageDescription}
      </p>
    </div>

    <!-- Featured Post -->
    {featured && (
      <section class="mb-20">
        <p class="text-xs uppercase tracking-wider text-black/40 mb-6">
          Featured
        </p>
        <a href={`/blog/${featured.id}`} class="group">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div class="aspect-[3/2] bg-black/5 overflow-hidden hidden md:block">
              {featured.data.thumbnail ? (
                <Image
                  src={featured.data.thumbnail}
                  alt=""
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  widths={[600, 900, 1200]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-black/5 to-black/10 group-hover:scale-105 transition-transform duration-500"></div>
              )}
            </div>
            <div>
              <p class="text-xs uppercase tracking-wider text-black/40 mb-3">
                {featured.data.category} · {featured.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              <h2 class="text-4xl font-serif mb-4 group-hover:underline">
                {featured.data.title}
              </h2>
              <p class="text-lg text-black/80 leading-relaxed mb-4">
                {featured.data.description}
              </p>
              {featured.data.readTimeMinutes && (
                <p class="text-sm text-black/50">
                  {featured.data.readTimeMinutes} min read
                </p>
              )}
            </div>
          </div>
        </a>
      </section>
    )}

    <!-- All Posts -->
    <section>
      <div class="mb-8">
        <p class="text-xs uppercase tracking-wider text-black/40 mb-2">
          All Posts
        </p>
        <div class="h-px bg-black/10"></div>
      </div>

      <div class="grid gap-12">
        {rest.map((post, index) => (
          <div>
            <a href={`/blog/${post.id}`} class="group">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
                <div class="aspect-[4/3] bg-black/5 overflow-hidden hidden md:block">
                  {post.data.thumbnail ? (
                    <Image
                      src={post.data.thumbnail}
                      alt=""
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      widths={[400, 600, 800]}
                      sizes="(max-width: 768px) 100vw, 33vw"
                    />
                  ) : (
                    <div
                      class="w-full h-full group-hover:scale-105 transition-transform duration-500"
                      style={`background: linear-gradient(${135 + index * 30}deg, rgba(0,0,0,0.05), rgba(0,0,0,0.1))`}
                    />
                  )}
                </div>
                <div class="col-span-2">
                  <p class="text-xs uppercase tracking-wider text-black/40 mb-3">
                    {post.data.category} · {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                    {post.data.readTimeMinutes ? ` · ${post.data.readTimeMinutes} min read` : ''}
                  </p>
                  <h3 class="text-2xl font-serif mb-3 group-hover:underline">
                    {post.data.title}
                  </h3>
                  <p class="text-black/60 leading-relaxed">
                    {post.data.description}
                  </p>
                </div>
              </div>
            </a>
            {index < rest.length - 1 && (
              <div class="h-px bg-black/10 mt-12"></div>
            )}
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
